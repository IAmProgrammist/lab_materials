% Переопределение команды для создания заголовков разделов
\renewcommand{\section}{%
	\@ifstar%
	{%
		\@ifnextchar[%
		{\b@section@opt@star}% Команда \section*[Раздел 1]{Раздел 1} с двумя аргументами со звёздочкой
		{\b@section@star}% Команда \section*{Раздел 1} с одним аргументом со звёздочкой
	}%
	{%
		\@ifnextchar[%
		{\b@section@opt}% Команда \section[Раздел 1]{Раздел 1} с двумя аргументами без звёздочки
		{\b@section}% Команда \section{Раздел 1} с одним аргументом без звёздочки
	}%
}%

% Команда для запрещения переносов по слогам внутри блока
\newcommand\without@hyphen{\setlength{\hyphenpenalty}{10000}\sloppy}

% Команда задаёт основной формат заголовков всех разделов, кроме приложений
\newcommand\b@startsection{
	\@startsection{section}{1}{\parindent}%
	{-3.5ex \@plus -1ex \@minus -0.2ex}% Отступ перед заголовком
	{0.1ex \@plus 0.2ex}% Отступ после заголовка
	{\without@hyphen\fontsize{15pt}{20pt}\selectfont\bfseries}% Стиль заголовка
}

% Команда \section со звёздочкой с одним аргументом (с номером раздела)
\newcommand{\b@section@star}[1]{%
	\everysection{#1}%
	\b@startsection*{#1}%
}

% Команда \section без звёздочки с одним аргументом (с номером раздела)
\newcommand{\b@section}[1]{%
	\everysection{#1}%	
	\b@startsection{#1}%
}

% Команда \section без звёздочки с двумя аргументами (с номером и опциональным заголовком)
\def\b@section@opt[#1]#2{%
	\everysection{#2}%
	\b@startsection[#1]{#2}%
}

% Команда \section со звёздочкой с двумя аргументами (с номером и опциональным заголовком)
\def\b@section@opt@star[#1]#2{%
	\everysection{#2}%
	\refstepcounter{section} % Создаём якорь для оглавления
	\addtocounter{section}{-1}	
	\addcontentsline{toc}{section}{#1}% Добавляем в оглавление опциональный заголовок
	\b@startsection*{#2}
}

% Подзаголовки
\renewcommand\subsection{\@startsection{subsection}{2}{\parindent}%
 	{-1.5ex\@plus -1ex \@minus -.2ex}%
	{0.1ex \@plus .2ex}%
	{\without@hyphen\fontsize{14.5pt}{19pt}\selectfont\bfseries}}
	
% Подподзаголовки
\renewcommand\subsubsection{\@startsection{subsubsection}{3}{\parindent}%
	{-1.5ex\@plus -1ex \@minus -.2ex}%
	{0.1ex \@plus .2ex}%
	{\without@hyphen\normalfont\bfseries}}

% Отступ между номером и название раздела
\renewcommand{\@seccntformat}[1]{\csname the#1\endcsname\hspace{0.5em}}

% Название текущего раздела (секции)
