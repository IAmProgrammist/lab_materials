\RequirePackage{caption}

% Ссылка на картинку имеет формат: <Номер раздела>.<Номер картинки>
\renewcommand{\thefigure}{\thesection.\arabic{figure}}

% В качестве разделителя используем тире 
\DeclareCaptionLabelSeparator{dashsep}{~--~}

\captionsetup[figure]{
	font=small,
	labelfont=md,	% Обычный шрифт
	justification=centering,
	labelsep=dashsep, % Разделитель - тире
	singlelinecheck=false,
	margin=30pt, % Отступ слева и справа
	skip=10pt,	% Отступ от картинки до надписи
	name=\rufigurename
}


