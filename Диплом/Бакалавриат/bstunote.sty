\makeatletter

\newcommand{\theappendix}{\Azbuk{section}}

% Команда для формирования заголовка приложения
\newcommand{\appendix@title}[1]{%
	{\centering\textbf{#1}\par}% Пишем заголовок приложения по центру
	\vspace{0.3em}% Добавляем вертикальный отступ после заголовка
}%

% Команда \section без звёздочки с одним аргументом  для создания заголовка приложения (с буквой приложения)
\newcommand{\b@appendix@section}[1]{%
	\clearpage%
	\refstepcounter{section}% Увеличиваем счётчик секций	
	\everysection{\ruappendixname \ \theappendix}%
	\addcontentsline{toc}{section}{\ruappendixname\ \theappendix\ #1}% Добавляем в содержание
	\appendix@title{\ruappendixname\ \theappendix\\#1}% Формируем заголовок
}

% Команда \section со звёздочкой с одним аргументом для создания заголовка приложения (с буквой приложения)
\newcommand{\b@appendix@section@star}[1]{%
	\clearpage%	
	\everysection{\ruappendixname}%
	\appendix@title{\ruappendixname\\#1}% Формируем заголовок
}


% Команда \section без звёздочки с двумя аргументами (с номером и опциональным заголовком) для приложения
\def\b@appendix@section@opt[#1]#2{%
	\clearpage%
	\everysection{\ruappendixname \ \theappendix}%
	\refstepcounter{section}% Увеличиваем счётчик секций
	\addcontentsline{toc}{section}{#1}% Добавляем в оглавление опциональный заголовок
	\appendix@title{\ruappendixname\ \theappendix\\#2}% Формируем заголовок
}

% Команда \section со звёздочкой с двумя аргументами (с номером и опциональным заголовком) для приложения
\def\b@appendix@section@opt@star[#1]#2{%
	\clearpage%
	\everysection{\ruappendixname}%
	\refstepcounter{section} % Создаём якорь для оглавления
	\addtocounter{section}{-1}
	\addcontentsline{toc}{section}{#1}% Добавляем в оглавление опциональный заголовок
	\appendix@title{\ruappendixname\\#2}% Формируем заголовок
}

% Команда секционирования для приложений
\newcommand{\appendix@section}{%
	\@ifstar%
	{%
		\@ifnextchar[%
		{\b@appendix@section@opt@star}% Команда \section*[Раздел 1]{Раздел 1} с двумя аргументами со звёздочкой
		{\b@appendix@section@star}% Команда \section*{Раздел 1} с одним аргументом со звёздочкой
	}%
	{%
		\@ifnextchar[%
		{\b@appendix@section@opt}% Команда \section[Раздел 1]{Раздел 1} с двумя аргументами без звёздочки
		{\b@appendix@section}% Команда \section{Раздел 1} с одним аргументом без звёздочки
	}%
}%

\let\oldappendix\appendix
\renewcommand{\appendix}{
	\clearpage
	\oldappendix
	\let\old@section\section
	% Переопределение команды \section для создания заголовков приложений
	\renewcommand{\section}{\appendix@section}
	
	% Разделы нумеруем прописными буквами русского алфавита
	\renewcommand{\thesection}{\Azbuk{section}}
	
}


