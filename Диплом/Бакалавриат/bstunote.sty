	singlelinecheck=false      % Не применять особое форматирование для однострочных подписей
}


% Основной стиль для листингов
\lstdefinestyle{baselistings}{%
	basicstyle=\ttfamily\footnotesize, % Моноширинный шрифт, уменьшенный размер
	frame=single, % Рамка вокруг листинга
	backgroundcolor=\color{gray!10}, % Светло-серый фон
	keywordstyle=\bfseries\color{blue!70!black}, % Стиль ключевых слов: полужирный синий цвет (70% насыщенности черного + синий) 
	commentstyle=\itshape\color{gray!60},% Стиль комментариев: курсив, светло-серый цвет
	stringstyle=\color{red!70!black}, % Стиль строк: красный цвет (70% насыщенности черного + красный)
	numbers=left,                 % Номера строк слева 
	numberstyle=\tiny\color{gray},% Номера строк пишем серым цветом
	xleftmargin=2em,         % Отступ слева
	xrightmargin=1em,        % Отступ справа
	showstringspaces=false,  % Не показывать пробелы в строках
	tabsize=2,               % Размер табуляции: 2 пробела
	breakatwhitespace=false, % Перенос строк только на пробелах
	columns=fullflexible,    % Гибкие колонки для лучшего выравнивания
	keepspaces=true,         % Сохранять пробелы в коде
	breakautoindent=true,    % Автоматический отступ при переносе строк
	breakindent=1em,         % Величина отступа при переносе: 1em
	breaklines=true,         % Перенос длинных строк	
	% Символ в конце перенесенной строки: серая стрелка с пробелом
	postbreak=\mbox{\textcolor{gray}{$\hookrightarrow$}\space},
	extendedchars=\true      % Включаем для отображения символов кириллицы в pdflatex
}

% Устанавливаем стиль baselistings по умолчанию
\lstset{style=baselistings}

