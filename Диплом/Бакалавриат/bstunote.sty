% Флаг, который равен значению "истина", если верстается первая страница раздела
% или "ложь" в противном случае
\newif\ifSection@Start

% Флаг, который означает, что пора рисовать рамки (после титульных листов)
\newif\ifBegin@Draw@Stamps
\Begin@Draw@Stampsfalse % Инициализируем его значением "ложь"

\RequirePackage{atbegshi}

% Функция выполняется после вёрстки очередной страницы
\AtBeginShipout{%
	\AtBeginShipoutUpperLeft{%
		\ifBegin@Draw@Stamps%		
			\ifSection@Start
			\begin{picture}(0, 0)%
				\put(20mm, \dimexpr -\paperheight + 5mm + \Frame@Bottom@Shift \relax){\Stamp@Form@II}%
			\end{picture}%
			\Raise@Border{25mm} % Опустить обратно нижний колонтитул			
			% Сбрасываем флаг, чтобы на следующих страницах рисовались маленькие штампы
			\global\Section@Startfalse
			\else
			% Если это не начало раздела, то рисуем маленькие штампы 
			\begin{picture}(0, 0)%
				\put(20mm, \dimexpr -\paperheight + 5mm + \Frame@Bottom@Shift \relax){\Stamp@Form@IIa}%
			\end{picture}%
			\fi
		\fi
	}
}


% Команда сдвигает нижний колонтитул по вертикали
\newcommand{\Raise@Border}[1]{
	\global\advance\vsize #1 % Сдвинуть нижний колонтитул
	\global\setlength{\@colht}{\vsize}
	\global\setlength{\@colroom}{\vsize}
}

% Действия, выполняемые в начале каждого раздела
\newcommand\everysection[1]{
	
	\typeout{Вёрстка раздела "#1"}
	
	% Перед началом раздела обязательно переходим на новую страницу
	\clearpage
	
	% Сохраняем текущее название раздела
	\global\def\theStampSection{#1}
	
	\ifdraw@stamps
	
		% Начинаем рисовать рамки
		\Begin@Draw@Stampstrue
		
		% Устанавливаем флаг для рисования большой рамки
		\global\Section@Starttrue
		
		% Приподнимаем текст над большой рамкой
		\Raise@Border{-25mm}
	\fi
	
	% Сбрасываем счётчик картинок
	\setcounter{figure}{0} 
	
	% Сбрасываем счётчик таблиц
	\setcounter{table}{0}
	
	% Сбрасываем счётчик листингов
	\setcounter{lstlisting}{0} 
	
}

