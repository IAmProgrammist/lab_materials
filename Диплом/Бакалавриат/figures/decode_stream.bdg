{"data":[{"data":"decode_stream(from_file)","type":"bd_element_terminator"},{"data":"f := open(from_file, \"rb\")","type":"bd_element_preprocess"},{"data":"Прочитать 4 байта из файла и \nсохранить как n_chunks","type":"bd_element_preprocess"},{"data":"Прочитать 4 байта и сохранить как\nsample_rate","type":"bd_element_preprocess"},{"data":{"data":"i = 0, n_chunks","body":{"data":[{"data":"Прочитать 4 байта, сохранить\nкак mode","type":"bd_element_preprocess"},{"data":"Прочитать 4 байта, сохранить \nкак size","type":"bd_element_preprocess"},{"data":"Прочитать чанк размером size, сохранить\nкак buf","type":"bd_element_preprocess"},{"data":"pcm_bytes = \nawait _decode_chunk(mode, buf, i, sample_rate)","type":"bd_element_preprocess"},{"data":{"negative":{"data":{"data":[],"type":"bd_element_container"},"position":"dec_right"},"data":"pcm_bytes is not None?","positive":{"data":{"data":[{"data":"yield pcm_bytes","type":"bd_element_terminator"}],"type":"bd_element_container"},"position":"dec_left"}},"type":"bd_element_decision"}],"type":"bd_element_container"}},"type":"bd_element_modifier"},{"data":"Выход","type":"bd_element_terminator"}],"type":"bd_element_container"}